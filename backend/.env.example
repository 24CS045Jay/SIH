ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgresql+asyncpg://kmrl:kmrl@localhost:5432/kmrl_portal
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
INTELLIGENCE_LLM_ENABLED=false
INTELLIGENCE_MODEL=gpt-5-mini
# OPENAI_API_KEY=placeholder-only
# OPENAI_API_BASE=placeholder-only
DEMO_PURGE_AFTER_JUDGING=false
STORAGE_PATH=/app/storage
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=kmrl-demo
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
MAX_UPLOAD_SIZE_MB=25
DEMO_PURGE_AFTER_JUDGING=false
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

# RAG reliability and grounding configuration
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
RAG_GENERATION_PROVIDER=openai
RAG_GENERATION_MODEL=gpt-4o-mini
RAG_VECTOR_TOP_K=15
RAG_KEYWORD_TOP_K=15
RAG_FINAL_TOP_K=4
RAG_MIN_RELEVANCE=0.18
RAG_MIN_RERANK_SCORE=0.20
RAG_DOCUMENT_SCOPE_DEFAULT=all
RAG_LOW_OCR_PENALTY=0.18
RAG_DIAGNOSTICS_ENABLED=true
