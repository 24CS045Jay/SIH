POSTGRES_DB=kmrl_portal
POSTGRES_USER=kmrl
POSTGRES_PASSWORD=replace-with-demo-password

# The backend reads backend/.env; copy backend/.env.example to backend/.env.
# Never commit either .env file.

# Backend RAG settings are passed through to backend/.env
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
RAG_GENERATION_PROVIDER=openai
RAG_GENERATION_MODEL=gpt-4o-mini
RAG_VECTOR_TOP_K=15
RAG_KEYWORD_TOP_K=15
RAG_FINAL_TOP_K=4
RAG_MIN_RELEVANCE=0.18
RAG_MIN_RERANK_SCORE=0.20
RAG_DOCUMENT_SCOPE_DEFAULT=all
